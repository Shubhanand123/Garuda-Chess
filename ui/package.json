{"name":"garuda-ui","private":true,"version":"0.1.0","scripts":{"build:js":"esbuild src/main.tsx --bundle --minify --format=iife --target=es2020 --define:process.env.NODE_ENV='\"production\"' --alias:@=./src --jsx=automatic --outfile=../site/ui.js","build:css":"tailwindcss -i src/ui.css -o ../site/ui.css --minify","build":"npm run build:js && npm run build:css"},"dependencies":{"clsx":"^2.1.1","framer-motion":"^11.18.2","react":"^18.3.1","react-dom":"^18.3.1","tailwind-merge":"^3.7.0"},"devDependencies":{"@tailwindcss/cli":"^4.3.3","@types/react":"^18.3.31","@types/react-dom":"^18.3.7","esbuild":"^0.28.2","tailwindcss":"^4.3.3"}}